DATABASE_URL="postgresql://postgres:1234@localhost:5432/venta"
TEST_DATABASE_URL="postgresql://postgres:1234@localhost:5432/venta-test"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://169.58.149.236:3000"
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (preferred file storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public URL base — optional; when unset, files are served via presigned URLs
R2_PUBLIC_BASE_URL=""
# Presigned URL lifetime in seconds (max 604800 = 7 days)
R2_PRESIGN_EXPIRES_SECONDS=604800
# Optional override (default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=""

# Legacy Tencent COS (optional fallback if R2 is not set)
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_REGION="ap-singapore"
COS_BUCKET=""
COS_PUBLIC_BASE_URL=""
