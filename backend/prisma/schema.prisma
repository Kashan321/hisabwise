  sentAt              DateTime                  @default(now()) @map("sent_at")

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sentBy            PlatformUser?      @relation(fields: [sentById], references: [id], onDelete: SetNull)
  paymentSubmission PaymentSubmission? @relation(fields: [paymentSubmissionId], references: [id], onDelete: SetNull)
  subscriptionRenewals SubscriptionRenewal[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status, alertEndsAt])
  @@index([businessId, kind, status, alertEndsAt])
  @@map("subscription_invoices")
}

model InventoryItem {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  name            String
  unit            InventoryUnit
  currentQuantity Decimal       @default(0) @map("current_quantity") @db.Decimal(14, 4)
  minThreshold    Decimal?      @map("min_threshold") @db.Decimal(14, 4)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItems             MenuItem[]            @relation("MenuItemInventory")
  menuItemVariants      MenuItemVariant[]     @relation("VariantInventory")
  modifierOptions       ModifierOption[]      @relation("ModifierInventory")
  recipeLines           InventoryRecipeLine[]
  movements             InventoryMovement[]
  dailyLines            InventoryDailyLine[]
  purchases             InventoryPurchase[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("inventory_items")
}

model InventoryRecipe {
  id                String  @id @default(uuid()) @db.Uuid
  businessId        String  @map("business_id") @db.Uuid
  menuItemId        String? @unique @map("menu_item_id") @db.Uuid
  menuItemVariantId String? @unique @map("menu_item_variant_id") @db.Uuid
  modifierOptionId  String? @unique @map("modifier_option_id") @db.Uuid

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem        MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemVariant MenuItemVariant?  @relation(fields: [menuItemVariantId], references: [id], onDelete: Cascade)
  modifierOption  ModifierOption?   @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  lines           InventoryRecipeLine[]

  @@index([businessId])
  @@map("inventory_recipes")
}

model InventoryRecipeLine {
  id              String        @id @default(uuid()) @db.Uuid
  recipeId        String        @map("recipe_id") @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  quantity        Decimal       @db.Decimal(14, 4)
  unit            InventoryUnit

  recipe        InventoryRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([inventoryItemId])
  @@map("inventory_recipe_lines")
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  businessId      String                @map("business_id") @db.Uuid
  businessDayId   String?               @map("business_day_id") @db.Uuid
  inventoryItemId String                @map("inventory_item_id") @db.Uuid
  type            InventoryMovementType
  quantityDelta   Decimal               @map("quantity_delta") @db.Decimal(14, 4)
  quantityAfter   Decimal               @map("quantity_after") @db.Decimal(14, 4)
  orderId         String?               @map("order_id") @db.Uuid
  orderItemId     String?               @map("order_item_id") @db.Uuid
  dailySessionId  String?               @map("daily_session_id") @db.Uuid
  wastageReason   InventoryWastageReason? @map("wastage_reason")
  unitCost        Decimal?              @map("unit_cost") @db.Decimal(14, 4)
  note            String?
  createdById     String?               @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessDay   BusinessDay?           @relation(fields: [businessDayId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  dailySession  InventoryDailySession? @relation(fields: [dailySessionId], references: [id], onDelete: SetNull)
  purchase      InventoryPurchase?

  @@index([businessId, inventoryItemId, createdAt])
  @@index([businessId, businessDayId])
  @@index([businessId, orderId])
  @@index([dailySessionId, inventoryItemId])
  @@map("inventory_movements")
}

model InventoryDailySession {
  id           String                      @id @default(uuid()) @db.Uuid
  businessId   String                      @map("business_id") @db.Uuid
  sessionDate  DateTime                    @map("session_date") @db.Date
  shiftName    String?                     @map("shift_name")
  status       InventoryDailySessionStatus @default(OPEN)
  openedById   String                      @map("opened_by_id") @db.Uuid
  closedById   String?                     @map("closed_by_id") @db.Uuid
  openedAt     DateTime                    @default(now()) @map("opened_at")
  closedAt     DateTime?                   @map("closed_at")
  openingNotes String?                     @map("opening_notes")
  closingNotes String?                     @map("closing_notes")

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  openedBy   User                  @relation("InventoryDailyOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy   User?                 @relation("InventoryDailyClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  lines      InventoryDailyLine[]
  purchases  InventoryPurchase[]
  movements  InventoryMovement[]

  @@index([businessId, status])
  @@index([businessId, sessionDate])
  @@map("inventory_daily_sessions")
}

model InventoryDailyLine {
  id                      String  @id @default(uuid()) @db.Uuid
  sessionId               String  @map("session_id") @db.Uuid
  inventoryItemId         String  @map("inventory_item_id") @db.Uuid
  openingQuantity         Decimal @map("opening_quantity") @db.Decimal(14, 4)
  expectedClosingQuantity Decimal? @map("expected_closing_quantity") @db.Decimal(14, 4)
  actualClosingQuantity   Decimal? @map("actual_closing_quantity") @db.Decimal(14, 4)
  variance                Decimal? @db.Decimal(14, 4)

  session       InventoryDailySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("inventory_daily_lines")
}

model InventoryPurchase {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  businessDayId   String?  @map("business_day_id") @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  movementId      String   @unique @map("movement_id") @db.Uuid
  quantity        Decimal  @db.Decimal(14, 4)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(14, 4)
  totalCost       Decimal? @map("total_cost") @db.Decimal(14, 4)
  supplier        String?
  supplierId      String?  @map("supplier_id") @db.Uuid
  invoiceRef      String?  @map("invoice_ref")
  notes           String?
  purchasedAt     DateTime @default(now()) @map("purchased_at")
  createdById     String   @map("created_by_id") @db.Uuid

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessDay   BusinessDay?          @relation(fields: [businessDayId], references: [id], onDelete: SetNull)
  session       InventoryDailySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  movement      InventoryMovement     @relation(fields: [movementId], references: [id], onDelete: Restrict)
  supplierRecord Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy     User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([businessId, purchasedAt])
  @@index([businessId, businessDayId])
  @@index([businessId, supplierId])
  @@map("inventory_purchases")
}

model Supplier {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  name               String
  phone              String?
  email              String?
  notes              String?
  openingBalanceOwed Decimal  @default(0) @map("opening_balance_owed") @db.Decimal(14, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases InventoryPurchase[]
  payments  SupplierPayment[]

  @@index([businessId, isActive])
  @@index([businessId, name])
  @@map("suppliers")
}

model SupplierPayment {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  paidAt      DateTime @default(now()) @map("paid_at")
  method      String?
  reference   String?
  notes       String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, supplierId, paidAt])
  @@map("supplier_payments")
}

model FeedbackTicket {
  id           String               @id @default(uuid()) @db.Uuid
  businessId   String               @map("business_id") @db.Uuid
  createdById  String               @map("created_by_id") @db.Uuid
  type         FeedbackTicketType
  priority     FeedbackPriority     @default(MEDIUM)
  subject      String?
  message      String               @db.Text
  imageKey     String?              @map("image_key")
  status       FeedbackTicketStatus @default(OPEN)
  adminNote    String?              @map("admin_note") @db.Text
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?            @map("reviewed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy  User          @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy PlatformUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
  @@map("feedback_tickets")
}

model PlatformFeedbackSettings {
  id           String   @id @default("default")
  email        String?
  phone        String?
  whatsapp     String?
  websiteUrl   String?  @map("website_url")
  supportHours String?  @map("support_hours") @db.Text
  extraNote    String?  @map("extra_note") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_feedback_settings")
}
