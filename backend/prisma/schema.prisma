generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionInvoiceStatus {
  OPEN
  PAID
  CANCELLED
}

enum SubscriptionInvoiceKind {
  PAYMENT_REQUEST
  PURCHASE_RECEIPT
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackTicketType {
  FEEDBACK
  BUG_REPORT
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeedbackTicketStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
}

enum InventoryUnit {
  KG
  G
  LITER
  ML
  PIECE
  PACK
  BOTTLE
}

enum InventoryTrackingMode {
  NONE
  SIMPLE_STOCK
  RECIPE
}

enum MenuPricingType {
  FIXED
  BY_WEIGHT
}

enum InventoryMovementType {
  SALE
  SALE_REVERSAL
  ADJUSTMENT
  RECEIPT
  WASTE
  INITIAL
}

enum InventoryDailySessionStatus {
  OPEN
  CLOSED
}

enum InventoryWastageReason {
  SPOILED
  DAMAGED
  EXPIRED
  PREPARATION_WASTE
  OTHER
}

enum KitchenTicketStatus {
  RECEIVED
  PREPARING
  READY
  CLEARED
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

model Business {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String             @unique
  location           String?
  city               String?
  branchNumber       String?            @map("branch_number")
  phone                    String?
  phoneSecondary           String?            @map("phone_secondary")
  receiptTemplateId        String?            @map("receipt_template_id") @db.Uuid
  receiptTemplateOverride  Json?              @map("receipt_template_override")
  logoUrl                  String?            @map("logo_url")
  primaryColor       String?            @map("primary_color")
  secondaryColor     String?            @map("secondary_color")
  backgroundColor    String?            @map("background_color")
  textColor          String?            @map("text_color")
  currency           String?            @map("currency")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  isSuspended        Boolean            @default(false) @map("is_suspended")
  isSubscriptionBlocked Boolean         @default(false) @map("is_subscription_blocked")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  subscriptionEndsAt DateTime?          @map("subscription_ends_at")
  billingInterval    BillingInterval?   @map("billing_interval")
  customMonthlyPrice Decimal?           @map("custom_monthly_price") @db.Decimal(10, 2)
  subscriptionTempAccessUntil DateTime? @map("subscription_temp_access_until")
  subscriptionTempAccessForPeriodEnd DateTime? @map("subscription_temp_access_for_period_end")
  allowNegativeInventory Boolean        @default(false) @map("allow_negative_inventory")
  orderTicketPrefix      String         @default("TKT") @map("order_ticket_prefix")
  orderTicketResetDaily  Boolean        @default(true) @map("order_ticket_reset_daily")
  defaultTaxRate         Decimal        @default(0) @map("default_tax_rate") @db.Decimal(6, 4)
  defaultDeliveryCharge  Decimal        @default(0) @map("default_delivery_charge") @db.Decimal(10, 2)
  nextOrderTicketNumber  Int            @default(1) @map("next_order_ticket_number")
  orderTicketDayKey      String?        @map("order_ticket_day_key")
  businessDayStartTime   String         @default("05:00") @map("business_day_start_time")
  businessDayTimezone    String         @default("Asia/Karachi") @map("business_day_timezone")
  businessDayAutoCloseEnabled      Boolean @default(true) @map("business_day_auto_close_enabled")
  businessDayCloseReminderEnabled  Boolean @default(true) @map("business_day_close_reminder_enabled")
  createdAt          DateTime           @default(now()) @map("created_at")

  users           User[]
  businessDays    BusinessDay[]
  inventoryItems  InventoryItem[]
  inventoryRecipes InventoryRecipe[]
  inventoryMovements InventoryMovement[]
  roles           Role[]
  userRoles       UserRole[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  modifierGroups  ModifierGroup[]
  floorTables     FloorTable[]
  floorPlans      FloorPlan[]
  orders              Order[]
  tenantAuditLogs     TenantAuditLog[]
  orderChangeRequests OrderChangeRequest[]
  customers       CustomerProfile[]
  reservations    Reservation[]
  promotions      Promotion[]
  notificationLogs NotificationLog[]
  inboxNotifications UserInboxNotification[]
  loyaltyTransactions LoyaltyTransaction[]
  paymentSubmissions PaymentSubmission[]
  subscriptionInvoices SubscriptionInvoice[]
  subscriptionRenewals SubscriptionRenewal[]
  cashShifts              CashShift[]
  cashDrawerMovements     CashDrawerMovement[]
  cashSettlementAccounts  CashSettlementAccount[]
  orderPayments      OrderPayment[]
  inventoryDailySessions InventoryDailySession[]
  inventoryPurchases     InventoryPurchase[]
  suppliers              Supplier[]
  supplierPayments       SupplierPayment[]
  feedbackTickets        FeedbackTicket[]
  riderCashSettlements   RiderCashSettlement[]
  kitchenTickets         KitchenTicket[]
  receiptTemplate        ReceiptTemplate?   @relation(fields: [receiptTemplateId], references: [id], onDelete: SetNull)

  @@map("businesses")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoles             UserRole[]
  refreshTokens           RefreshToken[]
  ordersCreated           Order[]              @relation("OrderCreatedBy")
  ordersAsWaiter          Order[]              @relation("OrderWaiter")
  ordersAsRider           Order[]              @relation("OrderRider")
  assignedTables          FloorTable[]         @relation("TableAssignedWaiter")
  tenantAuditLogs         TenantAuditLog[]
  changeRequestsMade      OrderChangeRequest[] @relation("ChangeRequestRequestedBy")
  changeRequestsReviewed  OrderChangeRequest[] @relation("ChangeRequestReviewedBy")
  cashShiftsOpened        CashShift[]          @relation("CashShiftOpenedBy")
  cashShiftsClosed        CashShift[]          @relation("CashShiftClosedBy")
  cashDrawerMovements     CashDrawerMovement[]
  orderPaymentsRecorded   OrderPayment[]
  ordersCompleted         Order[]              @relation("OrderCompletedBy")
  ordersPrepared          Order[]              @relation("OrderPreparedBy")
  kitchenTicketsPrepared  KitchenTicket[]      @relation("KitchenTicketPreparedBy")
  inventoryDailyOpened    InventoryDailySession[] @relation("InventoryDailyOpenedBy")
  inventoryDailyClosed    InventoryDailySession[] @relation("InventoryDailyClosedBy")
  inventoryPurchases      InventoryPurchase[]
  supplierPaymentsRecorded SupplierPayment[]
  feedbackTicketsCreated  FeedbackTicket[]     @relation("FeedbackCreatedBy")
  riderCashSettlementsAsRider     RiderCashSettlement[] @relation("RiderCashSettlementRider")
  riderCashSettlementsConfirmed   RiderCashSettlement[] @relation("RiderCashSettlementConfirmedBy")
  businessDaysOpened              BusinessDay[]       @relation("BusinessDayOpenedBy")
  businessDaysClosed              BusinessDay[]       @relation("BusinessDayClosedBy")
  inboxNotifications              UserInboxNotification[]
  notificationPreferences         UserNotificationPreference?

  @@index([businessId])
  @@map("users")
}

model BusinessDay {
  id                String            @id @default(uuid()) @db.Uuid
  businessId        String            @map("business_id") @db.Uuid
  businessDate      DateTime          @map("business_date") @db.Date
  startedAt         DateTime          @map("started_at")
  endedAt           DateTime?         @map("ended_at")
  status            BusinessDayStatus @default(OPEN)
  lastOrderSequence Int               @default(0) @map("last_order_sequence")
  openCount         Int               @default(1) @map("open_count")
  closeCount        Int               @default(0) @map("close_count")
  lastOpenedAt      DateTime          @map("last_opened_at")
  openedById        String            @map("opened_by_id") @db.Uuid
  closedById        String?           @map("closed_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  openedBy  User        @relation("BusinessDayOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  closedBy  User?       @relation("BusinessDayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  shifts             CashShift[]
  orders             Order[]
  inventoryMovements InventoryMovement[]
  inventoryPurchases InventoryPurchase[]

  @@unique([businessId, businessDate])
  @@index([businessId, status])
  @@map("business_days")
}

model Role {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String? @map("business_id") @db.Uuid
  name       String
  isSystem   Boolean @default(false) @map("is_system")

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([businessId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String @map("user_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  businessId String @map("business_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([businessId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  name         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@unique([businessId, name])
  @@index([businessId, displayOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  basePrice    Decimal? @map("base_price") @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url")
  isAvailable            Boolean               @default(true) @map("is_available")
  displayOrder           Int                   @default(0) @map("display_order")
  inventoryTrackingMode  InventoryTrackingMode @default(NONE) @map("inventory_tracking_mode")
  inventoryItemId        String?               @map("inventory_item_id") @db.Uuid
  pricingType            MenuPricingType       @default(FIXED) @map("pricing_type")
  pricePerKg             Decimal?              @map("price_per_kg") @db.Decimal(12, 2)
  pricingUnitG           Int?                  @map("pricing_unit_g")
  minWeightG             Int?                  @map("min_weight_g")
  weightStepG            Int?                  @map("weight_step_g")
  quickWeightsG          Json?                 @map("quick_weights_g")
  priceRounding          Int?                  @map("price_rounding")
  createdAt              DateTime              @default(now()) @map("created_at")

  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem?          @relation("MenuItemInventory", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  modifierGroups MenuItemModifierGroup[]
  variants       MenuItemVariant[]
  orderItems     OrderItem[]
  inventoryRecipe InventoryRecipe?

  @@index([businessId, categoryId])
  @@index([inventoryItemId])
  @@map("menu_items")
}

model MenuItemVariant {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  name         String
  price        Decimal  @db.Decimal(10, 2)
  basePrice    Decimal? @map("base_price") @db.Decimal(10, 2)
  isAvailable            Boolean               @default(true) @map("is_available")
  displayOrder           Int                   @default(0) @map("display_order")
  inventoryTrackingMode  InventoryTrackingMode @default(NONE) @map("inventory_tracking_mode")
  inventoryItemId        String?               @map("inventory_item_id") @db.Uuid

  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?   @relation("VariantInventory", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryRecipe InventoryRecipe?

  @@index([menuItemId, displayOrder])
  @@index([inventoryItemId])
  @@map("menu_item_variants")
}

model ModifierGroup {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  name       String
  isRequired Boolean @default(false) @map("is_required")
  minSelect  Int     @default(0) @map("min_select")
  maxSelect  Int     @default(1) @map("max_select")

  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  options   ModifierOption[]
  menuItems MenuItemModifierGroup[]

  @@unique([businessId, name])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String  @id @default(uuid()) @db.Uuid
  modifierGroupId String  @map("modifier_group_id") @db.Uuid
  name            String
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  isAvailable            Boolean               @default(true) @map("is_available")
  displayOrder           Int                   @default(0) @map("display_order")
  inventoryTrackingMode  InventoryTrackingMode @default(NONE) @map("inventory_tracking_mode")
  inventoryItemId        String?               @map("inventory_item_id") @db.Uuid

  modifierGroup   ModifierGroup    @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?   @relation("ModifierInventory", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryRecipe InventoryRecipe?

  @@index([modifierGroupId])
  @@index([inventoryItemId])
  @@map("modifier_options")
}

model MenuItemModifierGroup {
  menuItemId      String @map("menu_item_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  BOOTH
}

enum FloorElementType {
  DOOR
  WINDOW
  RECEPTION_COUNTER
  WALL
}

model FloorPlan {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  level      Int      @default(1)
  width      Float    @default(800)
  height     Float    @default(600)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tables   FloorTable[]
  elements FloorElement[]

  @@index([businessId, sortOrder])
  @@map("floor_plans")
}

model FloorElement {
  id          String           @id @default(uuid()) @db.Uuid
  floorPlanId String           @map("floor_plan_id") @db.Uuid
  type        FloorElementType
  layoutX     Float            @map("layout_x")
  layoutY     Float            @map("layout_y")
  width       Float
  height      Float
  rotation    Float            @default(0)
  options     Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([floorPlanId])
  @@map("floor_elements")
}

model FloorTable {
  id              String      @id @default(uuid()) @db.Uuid
  businessId      String      @map("business_id") @db.Uuid
  floorPlanId     String      @map("floor_plan_id") @db.Uuid
  tableIdentifier String      @map("table_identifier")
  layoutX         Float       @map("layout_x")
  layoutY         Float       @map("layout_y")
  width           Float       @default(80)
  height          Float       @default(80)
  capacity        Int         @default(4)
  shape           TableShape  @default(ROUND)
  rotation        Float       @default(0)
  status            TableStatus @default(AVAILABLE)
  assignedWaiterId  String?     @map("assigned_waiter_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")

  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  floorPlan      FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  assignedWaiter User?     @relation("TableAssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  orders         Order[]
  reservations   Reservation[]

  @@unique([floorPlanId, tableIdentifier])
  @@index([businessId, status])
  @@index([floorPlanId])
  @@index([assignedWaiterId])
  @@map("tables")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  QR
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
}

enum OrderChangeRequestType {
  CANCEL_ORDER
  REMOVE_ITEM
  MODIFY_ITEM
}

enum OrderChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderSource {
  QR_CUSTOMER
  STAFF_ASSISTED
  ONLINE_DELIVERY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WALLET
  ONLINE
  OTHER
}

enum OrderPaymentStatus {
  PAID
  PARTIAL
  PENDING
  FAILED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashClosingSettlementType {
  KEEP_IN_DRAWER
  HANDOVER_TO_OWNER
  TRANSFER_TO_WALLET
  TRANSFER_TO_BANK
  OTHER
}

enum CashSettlementAccountType {
  DRAWER
  OWNER
  WALLET
  BANK
  OTHER
}

enum CashDrawerMovementType {
  OPENING
  SALE
  REFUND
  PAY_IN
  PAY_OUT
  CLOSING
}

enum RiderCashSettlementStatus {
  PENDING
  CONFIRMED
}

model Order {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @map("business_id") @db.Uuid
  tableId         String?         @map("table_id") @db.Uuid
  customerId      String?         @map("customer_id") @db.Uuid
  promotionId     String?         @map("promotion_id") @db.Uuid
  createdById     String?         @map("created_by_id") @db.Uuid
  waiterId        String?         @map("waiter_id") @db.Uuid
  riderId         String?         @map("rider_id") @db.Uuid
  source          OrderSource
  orderType       OrderType       @default(DINE_IN) @map("order_type")
  status          OrderStatus     @default(RECEIVED)
  deliveryStatus  DeliveryStatus? @map("delivery_status")
  isDraft         Boolean         @default(false) @map("is_draft")
  sentToKitchenAt DateTime?       @map("sent_to_kitchen_at")
  paymentMethod   PaymentMethod?  @map("payment_method")
  paymentStatus   OrderPaymentStatus? @map("payment_status")
  cashShiftId     String?         @map("cash_shift_id") @db.Uuid
  businessDayId   String?         @map("business_day_id") @db.Uuid
  completedById   String?         @map("completed_by_id") @db.Uuid
  preparedById    String?         @map("prepared_by_id") @db.Uuid
  preparedAt      DateTime?       @map("prepared_at")
  subtotal        Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(10, 2)
  serviceAmount   Decimal         @default(0) @map("service_amount") @db.Decimal(10, 2)
  deliveryAmount  Decimal         @default(0) @map("delivery_amount") @db.Decimal(10, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  notes           String?
  customerName    String?         @map("customer_name")
  customerPhone   String?         @map("customer_phone")
  deliveryAddress String?         @map("delivery_address")
  deliveryNotes       String?         @map("delivery_notes")
  ticketNumber        Int?            @map("ticket_number")
  ticketPrefix        String?         @map("ticket_prefix")
  inventoryDeductedAt DateTime?       @map("inventory_deducted_at")
  inventoryReversedAt DateTime?       @map("inventory_reversed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table          FloorTable?          @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer       CustomerProfile?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion      Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  waiter         User?                @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  rider          User?                @relation("OrderRider", fields: [riderId], references: [id], onDelete: SetNull)
  cashShift      CashShift?           @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  businessDay    BusinessDay?         @relation(fields: [businessDayId], references: [id], onDelete: SetNull)
  completedBy    User?                @relation("OrderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  preparedBy     User?                @relation("OrderPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  changeRequests OrderChangeRequest[]
  payments       OrderPayment[]
  riderCashSettlement RiderCashSettlement?
  kitchenTickets      KitchenTicket[]

  @@index([businessId, status, createdAt])
  @@index([businessId, cashShiftId])
  @@index([businessId, waiterId])
  @@index([businessId, riderId])
  @@index([businessId, preparedById])
  @@index([businessId, orderType, deliveryStatus])
  @@index([businessId, isDraft])
  @@index([businessId, businessDayId])
  @@unique([businessDayId, ticketNumber])
  @@map("orders")
}

model OrderChangeRequest {
  id            String                   @id @default(uuid()) @db.Uuid
  businessId    String                   @map("business_id") @db.Uuid
  orderId       String                   @map("order_id") @db.Uuid
  requestedById String                   @map("requested_by_id") @db.Uuid
  reviewedById  String?                  @map("reviewed_by_id") @db.Uuid
  type          OrderChangeRequestType
  status        OrderChangeRequestStatus @default(PENDING)
  payload       Json?
  reason        String?
  reviewNote    String?                  @map("review_note")
  createdAt     DateTime                 @default(now()) @map("created_at")
